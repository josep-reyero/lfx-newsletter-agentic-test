---
# Example overrides for local development against an OrbStack / kind cluster.
# Copy to values.local.yaml and adjust as needed.

image:
  repository: ko.local/newsletter-api
  tag: local
  pullPolicy: Never

replicaCount: 1

app:
  logLevel: debug
  # NATS endpoint for the committee/project/email upstream clients.
  nats:
    url: "nats://lfx-platform-nats.lfx.svc.cluster.local:4222"
  requireUserAuth: false   # local dev only; production must validate JWTs
  jwksURL: ""

# Local dev convenience: render the RuleSet with allow_all instead of OpenFGA.
# NEVER do this outside a trusted local cluster — it disables route authorization.
openfga:
  enabled: false

# Standalone local deployment: chart provisions both the Cluster and the Database CRs.
database:
  mode: cluster+database
  cloudNativePG:
    clusterName: lfx-newsletter-db
    databaseName: newsletters
    cluster:
      instances: 1
      storage:
        size: 1Gi

networkPolicy:
  enabled: false   # easier debugging in local clusters
